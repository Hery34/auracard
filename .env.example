# Copier dans .env.local (ignoré par git). Valeurs locales : supabase status (pile supabase start).
# Validé au démarrage par src/server/infrastructure/env.ts : une variable absente ou invalide arrête l’application.

# URL de l’API Supabase (publique, inlinée dans le bundle client).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé anon (publique) : 20 caractères au moins.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (serveur uniquement, ADR 0011). Jamais exposée au client, jamais en argument de build.
SUPABASE_SERVICE_ROLE_KEY=

# Secret HMAC des clés de limitation de débit : 64 caractères hexadécimaux minuscules (openssl rand -hex 32), distinct par environnement.
RATE_LIMIT_SECRET=

# NODE_ENV est défini par Next.js : ne pas le définir ici.

# Public origin (https:// required in production, no trailing slash); optional outside production (default http://localhost:3000)
SITE_URL=https://carnet.example
