{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./supabase/.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(supabase db reset:*)",
      "Bash(psql:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(supabase db push:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-scope.mjs\""
          }
        ]
      }
    ]
  }
}
