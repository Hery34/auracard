        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_id: $('Build email').item.json.id }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "name": "carnet Supabase service_role"
        }
      }
    },
    {
      "id": "c4a1e0d2-3b5f-4e6a-9d7c-003300000008",
      "name": "Fail outbox",
