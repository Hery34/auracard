        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_id: $('Build email').item.json.id, p_error: 'smtp_send_failed' }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "name": "carnet Supabase service_role"
        }
      }
    },
    {
      "id": "c4a1e0d2-3b5f-4e6a-9d7c-003300000009",
      "name": "Next batch",
